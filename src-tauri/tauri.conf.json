{
  "productName": "Sorcery Desktop",
  "version": "0.1.3",
  "identifier": "com.srcuri.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "entitlements": null,
      "exceptionDomain": null
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main app capabilities",
          "windows": [
            "settings",
            "setup",
            "workspace-chooser",
            "revision-handler",
            "clone-dialog",
            "workspace-repair",
            "workspace-conflict",
            "large-file-confirm",
            "trust-warning"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "shell:default",
            "dialog:default",
            "dialog:allow-open",
            "fs:default",
            "fs:allow-exists",
            "fs:allow-read-dir",
            "fs:allow-read-file"
          ]
        }
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["srcuri"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNEVDQjMzRTc1OUVDRDkKUldUWjdGbm5NOHRPT3BiSU5LRWJhNm0rZGpocTl5Kzg2OGRmczd4bSt0Q0ZsYlphLzA2bEc2aDEK",
      "endpoints": [
        "https://github.com/ebeland/sorcery-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
